[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/ship_schematic.gd" id="1_schematic"]

[node name="ShipSchematic" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_schematic")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.05, 0.08, 0.94)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="MainVBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HeaderHBox" type="HBoxContainer" parent="Margin/MainVBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/MainVBox/HeaderHBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.2, 0.85, 1, 1)
theme_override_font_sizes/font_size = 20
text = "ASTRAEA-7 TACTICAL SCHEMATIC // 13 COMPARTMENTS & POWER GRID"

[node name="GridStatusLabel" type="Label" parent="Margin/MainVBox/HeaderHBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.2, 1)
theme_override_font_sizes/font_size = 14
text = "GRID STATUS: MAIN BUS ISOLATED"

[node name="BtnCloseSchematic" type="Button" parent="Margin/MainVBox/HeaderHBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(80, 32)
layout_mode = 2
text = "[X] Close"

[node name="AdvisoryPanel" type="PanelContainer" parent="Margin/MainVBox"]
layout_mode = 2

[node name="AdvMargin" type="MarginContainer" parent="Margin/MainVBox/AdvisoryPanel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

