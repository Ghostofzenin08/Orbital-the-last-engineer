[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/mission_complete.gd" id="1_comp"]

[node name="MissionComplete" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_comp")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.05, 0.08, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(620, 440)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.9, 0.4, 1)
theme_override_font_sizes/font_size = 24
text = "ORBITAL ESCAPE TRAJECTORY ACHIEVED"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.9, 1, 1)
theme_override_font_sizes/font_size = 14
text = "Astraea Biological Observatory Secured // Alien Threat Exterminated"
horizontal_alignment = 1

[node name="HSep" type="HSeparator" parent="Center/Panel/Margin/VBox"]
layout_mode = 2

[node name="BodyText" type="RichTextLabel" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
text = "As the Lead Scientist engaged the ion drives, the Astraea Biological Research Station safely broke orbit.

Arriving at the silent facility, you found the generators tripped, security panels dark, and the atmosphere choked with bio-spores. Step by step, you restored the massive plant and animal observatory chambers, tracked down the secret biological experiment that birthed the mutant alien predator, tactically lured the beast into the sealed chamber, and opened the emergency poisonous gas valve to exterminate it.

The research facility is secured, the fallen crew's memory honored, and Earth command notified.

The Lead Scientist's mission is accomplished."

[node name="ReturnButton" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 44)
layout_mode = 2
size_flags_horizontal = 4
text = "RETURN TO MAIN MENU"
